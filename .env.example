# ===== 复制本文件为 .env 后填写真实值，.env 已在 .gitignore 中，不会上传 =====

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# 正式上线建议改用 service_role（仅服务端使用，绝不能进前端），填了就优先用它
# SUPABASE_SERVICE_ROLE_KEY=

# ---- 模型密钥（有哪个填哪个，没填的模型会在下拉框里报错提示）----

# 豆包 / 火山方舟：model 要填「推理接入点 ID」或已开通的模型名
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-1-6-250615

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 通义千问 DashScope（兼容 OpenAI 模式）
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# Kimi / Moonshot
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

# ---- 可选：覆盖接口地址（走代理或本地 mock 联调时用）----
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1
